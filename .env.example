# Frontend, alt dizin yerine kök alan adı altında yayınlanacak.
VITE_BASE_PATH=/
# Backend API kök adresi (sonda / olmadan).
VITE_API_URL=http://localhost:8004
# Public site key. This value is intentionally bundled into the frontend.
VITE_TURNSTILE_SITE_KEY=
# Server-side only. Do not prefix this with VITE_ and do not use it in src/.
